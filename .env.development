# 应用端口
APP_PORT=3000

# 项目名称
VITE_APP_TITLE=vue3-element-admin

# 代理前缀
VITE_API_BASE=/dev-api

# 接口地址（开发代理转发目标，默认走线上）
API_PROXY_TARGET=https://www.youlai.tech     # 线上
# API_PROXY_TARGET=http://localhost:8000       # 本地

# Mock 开关
VITE_MOCK_ENABLED=false

# 多租户开关
VITE_TENANT_ENABLED=false

# AI 开关
VITE_AI_ENABLED=false

# 统一认证登录开关
VITE_OIDC_ENABLED=false
