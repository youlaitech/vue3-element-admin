# 应用端口
VITE_APP_PORT=3000

# 项目名称
VITE_APP_TITLE=vue3-element-admin

# 代理前缀
VITE_API_BASE=/dev-api

# 接口地址（开发代理转发目标，默认走线上）
VITE_PROXY_TARGET=https://api.youlai.tech       # 线上    
# VITE_PROXY_TARGET=http://localhost:8000       # 本地
# VITE_PROXY_TARGET=https://api.youlai.tech/v2  # 多租户线上

# Mock 开关
VITE_MOCK_ENABLED=false

# 多租户开关
VITE_TENANT_ENABLED=false

# AI 开关
VITE_AI_ENABLED=true
